---
import '@/styles/global.css';
import { SITE } from '@/config/site';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import type { Catalog } from '@/types/domain';

type Props = {
  title: string;
  /** Shown in the meta description. Falls back to the site default. */
  description?: string;
  /** The menu, loaded from content. The header hands it to the roadmap store. */
  catalog: Catalog;
};

const { title, description = SITE.defaultDescription, catalog } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader catalog={catalog} programTitle={catalog.program.title} />
    <slot />
  </body>
</html>
