---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoadmapSummary from '@/components/roadmap/RoadmapSummary.svelte';
import { getCatalog } from '@/lib/data/plan-data';

const catalog = await getCatalog();
---

<BaseLayout title={`Roadmap — ${catalog.program.title}`} catalog={catalog}>
  <main class="page">
    <h1>Your roadmap</h1>
    <p class="lede">The features you've chosen to fund for the Navigator, grouped by milestone.</p>

    <RoadmapSummary client:only="svelte" />
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-extrabold);
  }

  .lede {
    max-width: 44rem;
    margin-block: var(--space-xs) var(--space-xl);
    color: var(--color-text-quiet);
    font-size: var(--font-size-l);
  }
</style>
