{
  "name": "roadmap-builder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Assemble a roadmap from a catalog of milestones and features",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">= 22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:types": "astro check",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "checks": "pnpm run check:types && pnpm run check:lint && pnpm run check:format",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/svelte": "^9.1.6",
    "@nanostores/persistent": "^1.3.5",
    "astro": "^7.4.12",
    "elkjs": "^0.12.1",
    "nanostores": "^1.5.5",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
